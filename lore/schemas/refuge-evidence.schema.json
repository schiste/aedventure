{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "records",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "records": {
      "type": "array"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule": {
      "type": "string"
    }
  }
}
