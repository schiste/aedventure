      "after": 25,
      "state": {
        "clockSeconds": 3702,
        "resources": { "bassline": { "atLeast": 1 } },
        "heroMap": { "q": 0, "r": 3 },
        "base": { "studioRestored": true },
        "roster": {
          "heroAssigned": true,
          "heroRoleId": "role.crystal_bassline"
        }
      }
    },
    {
      "id": "save-round-trip-stable",
      "after": 26,
      "state": {
        "clockSeconds": 3702,
        "base": { "studioRestored": true },
        "activeConstruction": null,
        "activeWorldAction": null,
        "roster": {
          "heroAssigned": true,
          "heroRoleId": "role.crystal_bassline"
        }
